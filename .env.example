# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Котировки XAU/USD: twelvedata или oanda
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
# OANDA (бесплатный демо-счёт): токен из личного кабинета
OANDA_TOKEN=
OANDA_LIVE=0

# Текущая цена каждые CHECK_INTERVAL секунд: goldapi — gold-api.com (бесплатно, без ключа).
# С ним бесплатный Twelve Data тратится только на свечи при их закрытии (~300 запросов в день из 800).
# finnhub — Finnhub: на бесплатном ключе золото не отдаёт (403), нужен платный тариф.
PRICE_PROVIDER=goldapi
FINNHUB_API_KEY=
FINNHUB_SYMBOL=OANDA:XAU_USD

# Как часто проверять рынок, секунд (в выходные и в перерыв рынка запросов нет)
# 10–15 — с PRICE_PROVIDER=goldapi или платным Twelve Data; 130 — только бесплатный Twelve Data
CHECK_INTERVAL=10
# Стратегия. all — все стратегии на M15: squeeze, donchian, fvg_m15, liq_m15 (сигналы от каждой, у каждой
# не больше одной открытой сделки; встречный сигнал против открытой сделки не даётся). Сигналов на M5 нет.
# Можно указать одну стратегию или несколько через запятую, например: squeeze,fvg_m15
# Другие: combo (M15, сессии), fvg (H1). Подробности: reports/strategy_research.md
STRATEGY=all
# Стоп и тейк по волатильности: у каждого сигнала свои — SL_ATR × ATR(14) и TP_ATR × ATR(14) свечей M15
# (сейчас это примерно 200 / 300 пипсов). Стоп не меньше SL_MIN_PIPS. SL_ATR=0 — фиксированные SL_PIPS / TP_PIPS.
# Сравнение вариантов на истории: reports/sl_tp_research.md
SL_ATR=2
TP_ATR=3
SL_MIN_PIPS=50
SL_PIPS=100
TP_PIPS=200
# Фиксация части прибыли: цена прошла PARTIAL_R стопов → закрыть PARTIAL_PCT % позиции и перенести стоп в безубыток,
# остаток держать до тейка FINAL_TP_R стопов (тогда TP_ATR не используется). PARTIAL_R=0 — выключить.
# Встречный сигнал стратегии, пока сделка в плюсе (≥ REVERSAL_MIN_PIPS) → закрыть её (REVERSAL_CLOSE=0 — выкл.)
# Проверка на истории: reports/manage_research.md
PARTIAL_R=1
PARTIAL_PCT=50
FINAL_TP_R=3
REVERSAL_CLOSE=1
REVERSAL_MIN_PIPS=10
# Проп-счета FundedNext: по умолчанию без фиксации, тейк PROP_TP_R стопов (по симуляции челленджей так лучше);
# PROP_PARTIAL=1 — фиксация, безубыток и разворот и на проп-счетах
PROP_TP_R=1.5
PROP_PARTIAL=0
# Тренд или боковик: пробои (ADX_KEYS) не входят на обычных счетах и в сигналах, когда ADX(14) ≥ ADX_MAX;
# такой сигнал торгуется только на проп-счетах (как раньше). ADX_MAX=0 — выключить. reports/ideas_research.md
ADX_MAX=25
ADX_KEYS=squeeze,donchian
# Свечной анализ: пин-бар H1 против сигнала на последних CANDLE_PIN_HOURS свечах H1 (молот на дне — не продаём,
# падающая звезда на вершине — не покупаем) — сигнал пропускается. 0 — выключить. reports/candle_research.md
CANDLE_PIN_HOURS=2
# Две стратегии согласны (сигнал в ту же сторону за CONFLUENCE_MIN минут) — лот × CONFLUENCE_STRONG,
# одиночный сигнал — лот × CONFLUENCE_SINGLE. Проп-счета — как раньше. 1 и 1 — выключить. reports/profit_research.md
CONFLUENCE_MIN=60
CONFLUENCE_SINGLE=0.75
CONFLUENCE_STRONG=1.5
# лот в сигналах по капиталу подписчика: risk — стоп забирает не больше LOT_RISK_PCT % капитала;
# table — $50→0.01, $100→0.02, $200→0.03, дальше +0.01 за каждые $100
LOT_MODE=risk
LOT_RISK_PCT=1
# «вы опоздали»: цена ушла от входа к тейку на столько пипсов → предупреждение не входить
LATE_PIPS=30
# после стольких стопов подряд за день бот закрывает торговый день до завтра (0 — выключить)
MAX_SL_STREAK=0

# Подписка: пробный период, длительность и цена в Telegram Stars
TRIAL_DAYS=3
SUB_DAYS=30
SUB_PRICE_STARS=500

# Краткие разборы новостей через Claude (без ключа бот покажет просто заголовки)
ANTHROPIC_API_KEY=
# Часовой пояс для времени в сообщениях
DISPLAY_TZ=Asia/Tashkent
DB_PATH=/data/goldbot.db

# Пауза новых сигналов за N минут до и после важных новостей США (0 — выключить)
NEWS_PAUSE_MIN=30
# Какие новости ставят паузу: High (🔴) или High,Medium (🔴 и 🟠)
NEWS_PAUSE_IMPACT=High

# Фон новостей и геополитики (через Claude, нужен баланс Anthropic):
# 0 — только писать фон в сигнале, 1 — ещё и не давать сигнал против сильного фона
NEWS_FILTER=0

# За сколько минут до 🔴 новости США закрывать открытые сделки и предупреждать всех (0 — выключить)
NEWS_CLOSE_MIN=30
# Утренний разбор рынка (пн–пт) по местному времени DISPLAY_TZ; пусто — выключить
MORNING_REVIEW=08:00
# Итоги недели всем в воскресенье в это местное время; пусто — выключить
WEEKLY_REPORT=12:00
# Админам: сообщения об ошибках и о перезапуске бота (0 — выкл.); одна и та же ошибка — не чаще раза в 30 минут
ADMIN_ALERTS=1
ALERT_REPEAT_MIN=30
ALERT_STALL_MIN=5
# Копия базы каждый день в это время: папка backups рядом с базой (последние BACKUP_KEEP) и файл админам
BACKUP_TIME=03:00
BACKUP_KEEP=7
BACKUP_TO_ADMIN=1

# ── Автоторговля на счетах подписчиков (MT4/MT5 через MetaApi) ──
# Токен из https://app.metaapi.cloud/token (без токена кнопки «🤖 Автоторговля» нет)
METAAPI_TOKEN=
# Регион терминалов MetaApi (new-york, london, singapore …); пусто — по умолчанию
METAAPI_REGION=
# 1 — подключать только демо-счета (сначала проверяем на демо); 0 — разрешить реальные
AUTOTRADE_DEMO_ONLY=1
# Риск на сделку в % от средств на счёте (лот считается по реальному балансу счёта)
AUTOTRADE_RISK_PCT=1
# защита обычного счёта от плохих дней (reports/day_guard_research.md): после 4 Stop Loss за день — до завтра
# без новых сделок (0 — выкл.). AUTOTRADE_DAY_SIDE=0 — за день только в сторону первой сделки дня (выключено).
# Риск × AUTOTRADE_DD_MULT, когда баланс ниже максимума на AUTOTRADE_DD_PCT % (0 — выкл.: режет прибыль)
AUTOTRADE_DAY_LOSSES=4
AUTOTRADE_DAY_SIDE=1
AUTOTRADE_DD_PCT=0
AUTOTRADE_DD_MULT=0.5
# Максимальный лот на одну сделку
AUTOTRADE_MAX_LOT=1
# Символ золота у брокера; пусто — бот сам найдёт XAUUSD / XAUUSDm / GOLD
AUTOTRADE_SYMBOL=
# Автоторговля платная, отдельно от подписки на сигналы: цена в Telegram Stars за AUTOTRADE_DAYS дней.
# 1500 ⭐ подписчик покупает примерно за $30; вам после комиссии Telegram приходит меньше (~$20).
# Чтобы получать на руки ~$30, ставьте ~2300. AUTOTRADE_PRICE_USD — только подпись «≈ $30» в тексте.
AUTOTRADE_PRICE_STARS=1500
AUTOTRADE_PRICE_USD=30
AUTOTRADE_DAYS=30
# 1 — свечи и цена для анализа берутся с вашего (админа) счёта, подключённого через 🤖 Автоторговля, —
# тот же график, что у брокера в MT5. Если MetaApi долго не отвечает, бот минуту держит последнюю цену брокера,
# потом берёт PRICE_PROVIDER с поправкой на разницу с брокером. 0 — только DATA_PROVIDER / PRICE_PROVIDER.
MARKET_FROM_BROKER=1

# Защита от широкого спреда: спред у брокера > AUTOTRADE_MAX_SPREAD_PCT % стопа — ждать до AUTOTRADE_SPREAD_WAIT с,
# потом не открывать сделку на этом счёте (0 — выключить)
AUTOTRADE_MAX_SPREAD_PCT=10
AUTOTRADE_SPREAD_WAIT=60
# Сверка счетов раз в RECONCILE_SEC секунд: стоп на месте, нет «зависших» сделок, повтор неоткрывшейся (0 — выкл.)
RECONCILE_SEC=60
# Живая карточка сигнала: обновляется ход сделки раз в LIVE_CARD_MIN минут, фиксация и итог (LIVE_CARD=0 — выкл.)
LIVE_CARD=1
LIVE_CARD_MIN=5
# Прогноз челленджа и сообщения на 50 % и 90 % цели этапа FundedNext
PROP_MILESTONES=1
# Ссылка на проверенную статистику счёта (Myfxbook) — кнопка в «📈 Статистика»
MYFXBOOK_URL=

# Telegram-канал: бот отправляет туда всё то же, что подписчикам (сигналы, итоги, отчёты, новости).
# Обычно оставьте пустым: добавьте бота администратором в канал, и он подключит его сам (проверка: /channel).
# Или вручную: @имя_канала (открытый) или числовой ID вида -100… (закрытый). CHANNEL_LANG — ru, en или uz
CHANNEL_ID=
CHANNEL_LANG=ru
