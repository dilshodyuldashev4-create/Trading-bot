# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Котировки XAU/USD: twelvedata или oanda
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
# OANDA (бесплатный демо-счёт): токен из личного кабинета
OANDA_TOKEN=
OANDA_LIVE=0

# Как часто проверять рынок, секунд
# 15 — платный тариф Twelve Data или OANDA; 130 — бесплатный Twelve Data (800 запросов в день)
CHECK_INTERVAL=15
# Стратегия: combo (Silver Bullet + азиатский пробой, M15) или fvg (OB+FVG+BOS по тренду, H1)
STRATEGY=combo
SL_PIPS=100
TP_PIPS=200

# Подписка: пробный период и длительность (дней)
TRIAL_DAYS=3
SUB_DAYS=30
# Цена подписки в сумах
SUB_PRICE_UZS=150000
# Оплата через Click или Payme: токен из @BotFather → ваш бот → Payments → Click / Payme
PAYMENT_PROVIDER_TOKEN=
# Если токена нет — бот покажет эти реквизиты, подписчик нажмёт «Я оплатил»,
# а вам придёт кнопка «Выдать подписку»
PAY_DETAILS=Оплатите через Click или Payme на карту 8600 0000 0000 0000 (Имя Фамилия)

# Краткие разборы новостей через Claude (без ключа бот покажет просто заголовки)
ANTHROPIC_API_KEY=
# Часовой пояс для времени в сообщениях
DISPLAY_TZ=Asia/Tashkent
DB_PATH=/data/goldbot.db
