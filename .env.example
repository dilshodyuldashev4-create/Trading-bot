# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Котировки XAU/USD: twelvedata или oanda
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
# OANDA (бесплатный демо-счёт): токен из личного кабинета
OANDA_TOKEN=
OANDA_LIVE=0

# Текущая цена от Finnhub (бесплатный ключ на finnhub.io, ~60 запросов в минуту).
# С ним бесплатный Twelve Data тратится только на свечи при их закрытии (~400 запросов в день из 800),
# а цена для TP/SL проверяется каждые CHECK_INTERVAL секунд.
PRICE_PROVIDER=
FINNHUB_API_KEY=
FINNHUB_SYMBOL=OANDA:XAU_USD

# Как часто проверять рынок, секунд (в выходные и в перерыв рынка запросов нет)
# 10–15 — платный Twelve Data или PRICE_PROVIDER=finnhub; 130 — только бесплатный Twelve Data
CHECK_INTERVAL=15
# Стратегия. all — сразу все стратегии, которые в плюсе и в 2024–2026, и в 2026 году (сигналы от каждой,
# у каждой не больше одной открытой сделки): fvg_m5, rsi_m5, squeeze, trendline_m5, tl_bounce_m5, ema50_m5,
# combo, prevday_m5. Можно указать одну стратегию или несколько через запятую, например: squeeze,fvg_m5
# Другие: multi (4 сетапа на M15 одним сигналом), multi_m5, combo_trend, fvg (H1). Подробности: reports/strategy_research.md
STRATEGY=all
SL_PIPS=100
TP_PIPS=200
# лот в сигналах по капиталу подписчика: risk — стоп забирает не больше LOT_RISK_PCT % капитала;
# table — $50→0.01, $100→0.02, $200→0.03, дальше +0.01 за каждые $100
LOT_MODE=risk
LOT_RISK_PCT=2
# «вы опоздали»: цена ушла от входа к тейку на столько пипсов → предупреждение не входить
LATE_PIPS=30
# после стольких стопов подряд за день бот закрывает торговый день до завтра (0 — выключить)
MAX_SL_STREAK=2

# Подписка: пробный период, длительность и цена в Telegram Stars
TRIAL_DAYS=3
SUB_DAYS=30
SUB_PRICE_STARS=500

# Краткие разборы новостей через Claude (без ключа бот покажет просто заголовки)
ANTHROPIC_API_KEY=
# Часовой пояс для времени в сообщениях
DISPLAY_TZ=Asia/Tashkent
DB_PATH=/data/goldbot.db
