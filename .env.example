# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Котировки XAU/USD: twelvedata или oanda
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
# OANDA (бесплатный демо-счёт): токен из личного кабинета
OANDA_TOKEN=
OANDA_LIVE=0

# Как часто проверять рынок, секунд
# 15 — платный тариф Twelve Data или OANDA; 130 — бесплатный Twelve Data (800 запросов в день)
CHECK_INTERVAL=15
# Стратегия: combo (Silver Bullet + азиатский пробой, M15) или fvg (OB+FVG+BOS по тренду, H1)
STRATEGY=combo
SL_PIPS=100
TP_PIPS=200
# лот в сигналах по капиталу подписчика: risk — стоп забирает не больше LOT_RISK_PCT % капитала;
# table — $50→0.01, $100→0.02, $200→0.03, дальше +0.01 за каждые $100
LOT_MODE=risk
LOT_RISK_PCT=2

# Подписка: пробный период, длительность и цена в Telegram Stars
TRIAL_DAYS=3
SUB_DAYS=30
SUB_PRICE_STARS=500

# Краткие разборы новостей через Claude (без ключа бот покажет просто заголовки)
ANTHROPIC_API_KEY=
# Часовой пояс для времени в сообщениях
DISPLAY_TZ=Asia/Tashkent
DB_PATH=/data/goldbot.db
